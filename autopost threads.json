      "parameters": {
        "jsCode": "/****************************************************************\n *  cleanCaption  – ambil teks Gemini & rapikan\n *  ------------------------------------------------------------\n *  Input  : output node \"Analyze image\"\n *  Output : { shortText }  (string ≤500 karakter, emoji OK)\n ****************************************************************/\n\n// 1.  ambil teks dari Gemini  content.parts[0].text\nlet raw = '';\ntry {\n\traw = $json.content.parts[0].text;\n} catch {\n\traw = JSON.stringify($json);           // fallback\n}\n\n// 2.  hapus karakter tak terlihat & newline berlebih\nlet clean = raw\n\t.replace(/[\\u0000-\\u001F\\u007F]/g, ' ')   // control chars\n\t.replace(/\\s+\\n/g, '\\n')                  // trim spasi sebelum \\n\n\t.replace(/\\n{2,}/g, '\\n')                 // max 1 newline\n\t.trim();\n\n// 3.  potong ke 500 char (limit Threads)\nif (clean.length > 500) clean = clean.slice(0, 497) + '…';\n\n// 4.  keluar‑kan\nreturn { shortText: clean };\n"
      },
